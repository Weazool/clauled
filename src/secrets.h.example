// ============================================================
//  Clauled configuration template
//
//    cp src/secrets.h.example src/secrets.h
//
//  src/secrets.h is gitignored. NEVER commit it.
//  THIS file (.example) is tracked, so keep it free of real values.
// ============================================================

#pragma once

// ── WiFi ──────────────────────────────────────────────────────
// Both are required. A blank value is a compile error, not a
// silent boot failure.
#define WIFI_SSID        ""
#define WIFI_PASSWORD    ""

// ── Push endpoint auth ────────────────────────────────────────
// Shared secret the desktop pusher sends as the X-Clauled-Key
// header. Anything on your LAN can reach the device, so this
// must not be empty. Generate one with:
//
//   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
//
#define CLAULED_PUSH_KEY ""

// ── Network identity ──────────────────────────────────────────
// The device advertises itself over mDNS so the pusher can target
// http://clauled.local/push and ignore DHCP entirely.
#define CLAULED_HOSTNAME "clauled"

// ── Display interface ─────────────────────────────────────────
// Two module types are supported:
//   4-pin I2C  (GND VCC SCL SDA)                  -> leave DISPLAY_SPI commented
//   7-pin SPI  (GND VCC D0/SCK D1/SDA RES DC CS)  -> define DISPLAY_SPI
//
// Safe GPIOs on ESP32-C3: 0, 1, 3, 4, 5, 6, 7, 10. Avoid 2 and 8 (boot
// strapping), 9 (BOOT button), 11-17 (SPI flash), and 18/19 (USB - using
// them costs you serial and flashing).
// #define DISPLAY_SPI

// SPI wiring (only used when DISPLAY_SPI is defined)
#define OLED_MOSI           4      // module pin "SDA" / "D1"
#define OLED_CLK            5      // module pin "SCK" / "D0"
#define OLED_DC             6
#define OLED_RST            7
#define OLED_CS            10

// I2C wiring (only used when DISPLAY_SPI is NOT defined)
#define SDA_PIN             4
#define SCL_PIN             5

// ── Display ───────────────────────────────────────────────────
#define CYCLE_TIME          5      // seconds per page; 0 = manual (BOOT button)
#define SHOW_WEEKLY_SONNET  false  // separate Sonnet weekly bucket (Max plans)
#define SHOW_UPTIME         false  // show a device-uptime page
#define STALE_AFTER_S       300    // no push for this long -> mark data stale
